{
  "name": "@theokit/gateway-integration",
  "version": "0.0.0",
  "private": true,
  "description": "Live end-to-end tests against the real platform APIs. Deliberately has no \"test\" script: `pnpm -r run test` must never spend money or post into a chat. The offline units under tests/unit run on every PR via \"test:unit\", which that command cannot reach.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "integration": "vitest run",
    "integration:watch": "vitest",
    "readiness": "vitest run tests/readiness.test.ts",
    "test:unit": "vitest run tests/unit tests/readiness.test.ts",
    "typecheck": "tsc --noEmit",
    "env:example": "tsx scripts/env-example.ts",
    "discover:telegram": "tsx scripts/discover-telegram.ts",
    "session:telegram": "tsx scripts/mint-telegram-session.ts",
    "bootstrap:telegram": "tsx scripts/bootstrap-telegram.ts",
    "matrix:up": "tsx scripts/bootstrap-matrix.ts",
    "matrix:down": "tsx scripts/teardown-docker.ts matrix",
    "mattermost:up": "tsx scripts/bootstrap-mattermost.ts",
    "mattermost:down": "tsx scripts/teardown-docker.ts mattermost",
    "capture:line": "tsx scripts/capture-line-user.ts"
  },
  "devDependencies": {
    "@line/bot-sdk": "^9.0.0",
    "@mattermost/client": "^10.0.0",
    "@theokit/gateway": "workspace:*",
    "@theokit/gateway-discord": "workspace:*",
    "@theokit/gateway-email": "workspace:*",
    "@theokit/gateway-line": "workspace:*",
    "@theokit/gateway-matrix": "workspace:*",
    "@theokit/gateway-mattermost": "workspace:*",
    "@theokit/gateway-slack": "workspace:*",
    "@theokit/gateway-sms": "workspace:*",
    "@theokit/gateway-teams": "workspace:*",
    "@theokit/gateway-telegram": "workspace:*",
    "@theokit/gateway-whatsapp": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.0",
    "matrix-js-sdk": "^37.0.0",
    "nodemailer": "^8.0.0",
    "telegram": "^2.26.22",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0",
    "ws": "^8.18.0"
  }
}
