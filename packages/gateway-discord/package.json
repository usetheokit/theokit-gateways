{
  "name": "@theokit/gateway-discord",
  "version": "0.1.5",
  "description": "Discord (discord.js) platform adapter for @theokit/gateway. ADRs D171, D179.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-gateways.git",
    "directory": "packages/gateway-discord"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": ">=0.6.0 <1.0.0",
    "discord.js": "^14.16.0"
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/sdk": "^4.62.0",
    "discord.js": "^14.16.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
