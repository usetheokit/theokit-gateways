{
  "name": "@theokit/gateway-matrix",
  "version": "0.1.3",
  "description": "Matrix protocol platform adapter for @theokit/gateway. ADRs D413-D421.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": ">=0.6.0 <1.0.0",
    "@theokit/sdk": "^2.18.0",
    "matrix-js-sdk": "^32.0.0"
  },
  "peerDependenciesMeta": {
    "matrix-js-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/sdk": "^2.18.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
