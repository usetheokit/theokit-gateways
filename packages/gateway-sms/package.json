{
  "name": "@theokit/gateway-sms",
  "version": "0.3.1",
  "description": "SMS platform adapter for @theokit/gateway. Multi-backend (Twilio + Plivo + Vonage). ADRs D389-D396.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-gateways.git",
    "directory": "packages/gateway-sms"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@theokit/gateway": ">=0.9.0 <1.0.0",
    "@vonage/server-sdk": "^3.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "libphonenumber-js": "^1.10.0",
    "plivo": "^4.0.0",
    "twilio": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "twilio": {
      "optional": true
    },
    "plivo": {
      "optional": true
    },
    "@vonage/server-sdk": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "10",
    "@stryker-mutator/vitest-runner": "10",
    "@theokit/gateway": "workspace:*",
    "@theokit/sdk": "^4.62.0",
    "@types/express": "^5.0.6",
    "@vonage/server-sdk": "^3.0.0",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.13.12",
    "plivo": "^4.0.0",
    "tsup": "^8.5.0",
    "twilio": "^6.1.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-gateways/issues"
  },
  "homepage": "https://github.com/usetheokit/theokit-gateways/tree/main/packages/gateway-sms#readme",
  "keywords": [
    "theokit",
    "gateway",
    "sms",
    "platform",
    "adapter",
    "multi-backend",
    "twilio",
    "plivo"
  ]
}
