{
  "name": "@theokit/gateway-sms",
  "version": "0.1.3",
  "description": "SMS platform adapter for @theokit/gateway. Multi-backend (Twilio + Plivo + Vonage). ADRs D389-D396.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-gateways.git",
    "directory": "packages/gateway-sms"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": ">=0.6.0 <1.0.0",
    "@theokit/sdk": "^2.18.0",
    "@vonage/server-sdk": "^3.0.0",
    "express": "^4.18.0",
    "libphonenumber-js": "^1.10.0",
    "plivo": "^4.0.0",
    "twilio": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "twilio": {
      "optional": true
    },
    "plivo": {
      "optional": true
    },
    "@vonage/server-sdk": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/sdk": "^2.18.0",
    "@types/express": "^4.17.0",
    "@vonage/server-sdk": "^3.0.0",
    "express": "^4.18.0",
    "libphonenumber-js": "^1.10.0",
    "plivo": "^4.0.0",
    "tsup": "^8.5.0",
    "twilio": "^5.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
