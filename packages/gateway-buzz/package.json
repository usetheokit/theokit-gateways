{
  "name": "@theokit/gateway-buzz",
  "version": "0.0.0",
  "description": "Buzz platform adapter for @theokit/gateway, over the REST API and realtime WebSocket with a bot token.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-gateways.git",
    "directory": "packages/gateway-buzz"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": ">=0.12.0 <1.0.0"
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/gateway-bot-realtime": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-gateways/issues"
  },
  "homepage": "https://github.com/usetheokit/theokit-gateways/tree/main/packages/gateway-buzz#readme",
  "keywords": [
    "theokit",
    "gateway",
    "chat",
    "buzz",
    "platform",
    "adapter"
  ]
}
