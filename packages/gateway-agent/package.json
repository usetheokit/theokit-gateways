{
  "name": "@theokit/gateway-agent",
  "version": "0.0.0",
  "description": "Agent bridge for @theokit/gateway: run a TheoKit SDK agent turn to text and deliver text to a channel rendered for its platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-gateways.git",
    "directory": "packages/gateway-agent"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": ">=0.16.0 <1.0.0",
    "@theokit/presenter": ">=0.10.0 <1.0.0",
    "@theokit/sdk": ">=2.18.0 <6"
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/presenter": "^0.10.0",
    "@theokit/sdk": "^5.9.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/usetheokit/theokit-gateways/issues"
  },
  "homepage": "https://github.com/usetheokit/theokit-gateways/tree/main/packages/gateway-agent#readme",
  "keywords": [
    "theokit",
    "gateway",
    "agent",
    "sdk",
    "presenter"
  ]
}
