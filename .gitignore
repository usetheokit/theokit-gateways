node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
.DS_Store

# Claude Code cycle tooling + audit artifacts (not shipped source)
.claude/
architect-output/

# Filled-in environment files. A filled-in `.env` once reached this repository
# with real Slack and OpenRouter credentials, because no rule here matched it.
# Integration tests read their credentials from an untracked `.env`; CI reads
# them from repository secrets. Only `.env.example` — placeholders documenting
# which variables exist — is ever tracked.
.env
.env.*
!.env.example

# SDK runtime state, written by the agent as it runs: agent registry, message
# transcripts, memory sessions. The same import that carried the `.env` above
# also left a tracked registry.json holding the absolute path of a developer's
# home directory in a public repository. Runtime state is per-machine — it
# never belongs in version control.
.theokit/

# Stryker mutation testing: sandbox scratch space and generated HTML report.
# Both are regenerated by `pnpm --filter @theokit/gateway run test:mutation`.
.stryker-tmp/
reports/

# Scratch written by tools/repair-dts-imports.mjs: a one-line probe compiled inside a package to
# ask the compiler where a type comes from. It is deleted in a `finally`, and stale ones are swept
# at the start of the next run — but a hard kill runs neither, and the leftover is a `.ts` file in
# a published package's directory that a `git add -A` would happily commit.
.dts-probe-*.ts
