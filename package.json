{
  "name": "theokit-gateways-monorepo",
  "private": true,
  "releaseChannel": "latest",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.1"
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "scripts": {
    "build": "pnpm -r run build && node tools/repair-dts-imports.mjs",
    "quality:dts-typechecks": "node tools/check-dts-typechecks.mjs",
    "quality:dts-parity": "node tools/check-dts-export-parity.mjs",
    "quality:registry-augmentation": "node tools/check-registry-augmentation.mjs",
    "quality:integration-story": "node tools/check-integration-story.mjs",
    "quality:repository-field": "node tools/check-repository-field.mjs",
    "quality:peer-range": "node tools/check-peer-range-tested.mjs",
    "quality:doc-api": "node tools/check-doc-api-drift.mjs",
    "quality:doc-orphans": "node tools/check-orphan-docblocks.mjs",
    "quality:doc-coverage": "node tools/check-doc-coverage.mjs",
    "quality:docs": "pnpm quality:doc-api && pnpm quality:doc-orphans && pnpm quality:doc-coverage",
    "test": "pnpm -r run test",
    "integration": "pnpm --filter @theokit/gateway-integration integration",
    "integration:readiness": "pnpm --filter @theokit/gateway-integration readiness",
    "typecheck": "pnpm -r run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "quality:adr-citations": "node tools/check-adr-citations.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.20.1",
    "knip": "^5.88.1",
    "theokit": "^0.60.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ],
    "overrides": {
      "form-data@<2.5.4": ">=2.5.4",
      "proxy-addr@<2.0.8": "^2.0.8",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "ip-address@<=10.3.0": ">=10.3.1",
      "sharp@<0.35.5": "^0.35.5",
      "nodemailer@<=10.0.5": ">=10.0.6",
      "undici@>=4.0.0 <6.29.1": "^6.29.1",
      "axios@>=1.13.0 <1.20.0": "^1.20.0",
      "basic-ftp@<=6.2.0": ">=6.2.1",
      "devalue@<=5.9.2": ">=5.9.3",
      "joi@>=17.1.1 <17.13.9": "^17.13.9",
      "follow-redirects@>=1.16.0 <=1.16.1": ">=1.16.2",
      "vite@>=7.0.0 <=7.3.6": "^7.3.7",
      "vite@>=8.0.0 <8.1.6": "^8.1.6",
      "zod@<4.6.6": "^4.6.6",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "@azure/msal-node@>=5.0.0-beta.0 <7.1.0": "^7.1.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3"
      ]
    }
  }
}
